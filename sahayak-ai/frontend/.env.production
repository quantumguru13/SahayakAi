# Production build (Firebase Hosting).
#
# The backend runs on Render, on a different origin, so this must be the FULL
# URL of that service — e.g. https://sahayak-ai-api.onrender.com (no trailing
# slash). The API client appends /api/v1 and /health itself.
#
NEXT_PUBLIC_API_URL=https://sahayakai-hm7u.onrender.com

# --- Supabase Auth (optional) ---
# Leave BOTH blank to deploy the keyless demo (no login gate).
# Filling these in turns on the login gate AND makes the backend enforce JWTs.
# Remember to add your Hosting URL to Supabase -> Auth -> URL Configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
