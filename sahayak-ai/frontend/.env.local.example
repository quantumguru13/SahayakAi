# URL of the FastAPI backend. Defaults to http://localhost:8000 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase Auth (optional) ---
# Leave BOTH blank to run the keyless demo (no login gate).
# Set both to enable Google / email sign-in. From Supabase -> Project Settings -> API:
#   "Project URL"           -> NEXT_PUBLIC_SUPABASE_URL
#   "sb_publishable_..." key -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
