# ---------------------------------------------------------------------------
# Sahayak AI backend configuration
# Copy to `.env` and fill in only what you need. This file is a TEMPLATE and is
# committed — never put a real key in it.
#
# With no keys set the app runs fully offline: Tesseract OCR + the deterministic
# rule extractor + in-memory seeded data. That is the intended demo posture.
# ---------------------------------------------------------------------------

# --- OpenAI (OPTIONAL — leave blank to stay fully offline) ---
# Even with a key present, OpenAI is only used when USE_OPENAI=true below.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.1

# Opt in to GPT-4o for OCR/extraction/embeddings. Default false keeps the
# document pipeline offline and free of any paid API.
USE_OPENAI=false

# --- Supabase (OPTIONAL — schema provided in ../supabase) ---
# Setting SUPABASE_URL enables JWT auth. Adding SUPABASE_SERVICE_KEY switches
# the store from in-memory to PostgreSQL. The service key bypasses row-level
# security — treat it like a root password and never commit it.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# --- OCR ---
# Only needed if tesseract.exe is not on PATH (the app auto-detects the standard
# Windows install locations first).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Behaviour ---
# Force demo mode even if keys are present (guaranteed offline stage demo).
FORCE_DEMO_MODE=false
# Force-disable auth even when Supabase is configured.
FORCE_DISABLE_AUTH=false
# Retain uploaded imagery in the pipeline-debug payload. Off by default so an
# Aadhaar photo is discarded once its fields have been read.
AUDIT_MODE=false

# Comma-separated allowed CORS origins for the Next.js frontend.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
