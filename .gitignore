# ---------------------------------------------------------------------------
# Sahayak AI — repository ignore rules
# ---------------------------------------------------------------------------

# --- Secrets: never commit real credentials ---------------------------------
# Only *.example templates belong in the repo.
.env
.env.*
!.env.example
!.env.local.example
# NEXT_PUBLIC_* values are compiled into the client bundle, so they are public
# by definition — keeping this committed makes the frontend deploy reproducible.
!.env.production
*.pem
*.key
secrets.json

# --- Python backend ---------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Node / Next.js frontend ------------------------------------------------
node_modules/
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Editor / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Claude Code ------------------------------------------------------------
# launch.json is shared (dev-server config); settings.local.json is per-machine.
.claude/settings.local.json

# --- Firebase ---------------------------------------------------------------
# Local deploy cache; firebase.json / .firebaserc are committed.
.firebase/

# --- Misc -------------------------------------------------------------------
*.log
tmp/
temp/
